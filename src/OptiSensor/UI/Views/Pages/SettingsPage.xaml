<UserControl x:Class="OptiSensor.UI.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>
            <TextBlock Text="Startup, persistence, and helper lifecycle settings."
                       Margin="0,6,0,20"
                       Foreground="#64748B"/>

            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Start with Windows"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Content="Register startup task"
                              VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Text="Publish interval"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <ComboBox x:Name="PublishIntervalComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Width="128"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="500ms" Tag="500"/>
                        <ComboBoxItem Content="1000ms" Tag="1000"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Updates"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Check GitHub Releases for a newer OptiSensor version."
                               Margin="0,10,0,0"
                               Foreground="#334155"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Check for updates"
                                MinWidth="136"
                                Style="{StaticResource NeutralButtonStyle}"
                                Click="CheckForUpdatesButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStateTextBlock"
                               Margin="0,8,0,0"
                               Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="About"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="OptiSensor publishes selected local hardware sensor values to OptiScaler's external overlay shared memory feed."
                               Margin="0,10,0,0"
                               Foreground="#334155"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click"/>
                <Button Content="Open Settings Folder"
                        MinWidth="150"
                        Margin="0,0,8,0"
                        Style="{StaticResource NeutralButtonStyle}"
                        Click="OpenSettingsFolderButton_Click"/>
                <Button Content="Hide to Tray"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Style="{StaticResource NeutralButtonStyle}"
                        Click="HideButton_Click"/>
                <Button Content="Exit"
                        MinWidth="88"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
