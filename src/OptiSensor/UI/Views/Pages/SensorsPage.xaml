<UserControl x:Class="OptiSensor.UI.Views.Pages.SensorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Sensors"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="All LibreHardwareMonitor sensors detected on this PC. Toggle a row to add or remove it from the overlay."
                           Margin="0,6,0,0"
                           Foreground="#64748B"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource FluentCardStyle}">
            <DataGrid x:Name="DetectedSensorsDataGrid"
                      ItemsSource="{Binding DetectedSensors}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      RowHeight="34">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <EventSetter Event="Loaded" Handler="GroupItem_Loaded"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True"
                                                      Expanded="GroupExpander_Expanded"
                                                      Collapsed="GroupExpander_Collapsed"
                                                      Margin="0,0,0,8"
                                                      Background="#F8FAFC"
                                                      BorderBrush="#E2E8F0"
                                                      BorderThickness="1">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="8,4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#0F172A"/>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat= ({0})}"
                                                                   Margin="4,0,0,0"
                                                                   Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="0,4,0,0"/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Overlay" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Hardware Type" Binding="{Binding HardwareType}" IsReadOnly="True" Width="130"/>
                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" IsReadOnly="True" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
