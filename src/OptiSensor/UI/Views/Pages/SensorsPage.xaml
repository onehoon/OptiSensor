<UserControl x:Class="OptiSensor.UI.Views.Pages.SensorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Sensors"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="All LibreHardwareMonitor sensors detected on this PC. Check a row to add or remove it from the overlay."
                           Margin="0,6,0,0"
                           Foreground="#64748B"/>
                <ItemsControl ItemsSource="{Binding SensorCategoryFilters}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,12,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource FluentCardStyle}">
            <DataGrid x:Name="DetectedSensorsDataGrid"
                      ItemsSource="{Binding DetectedSensors}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Overlay"
                                            Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="80">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource FluentDataGridCheckBoxStyle}"/>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource FluentDataGridCheckBoxStyle}"/>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Hardware Type" Binding="{Binding HardwareType}" IsReadOnly="True" Width="130"/>
                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" IsReadOnly="True" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
