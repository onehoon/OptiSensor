<UserControl x:Class="OptiSensor.UI.Views.Pages.SensorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Sensors"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Detected sensors from LibreHardwareMonitor. Select a sensor and add it to the overlay."
                           Margin="0,6,0,0"
                           Foreground="#64748B"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="RefreshButton_Click"/>
                <Button Content="Add"
                        MinWidth="88"
                        Style="{StaticResource NeutralButtonStyle}"
                        Click="AddButton_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Style="{StaticResource FluentCardStyle}">
            <DataGrid x:Name="DetectedSensorsDataGrid"
                      ItemsSource="{Binding DetectedSensors}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="2*"/>
                    <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" Width="120"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
