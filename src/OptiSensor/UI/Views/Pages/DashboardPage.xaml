<UserControl x:Class="OptiSensor.UI.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OptiSensor.UI.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>
            <TextBlock Text="Current helper status and overlay publishing summary."
                       Margin="0,6,0,22"
                       Foreground="#64748B"/>

            <UniformGrid Columns="2">
                <controls:StatusCard x:Name="StatusCard" Title="Status"/>
                <controls:StatusCard x:Name="OverlayCard" Title="Last Overlay"/>
                <controls:StatusCard x:Name="PublishCard" Title="Publish"/>
                <controls:StatusCard x:Name="OptiScalerCard" Title="OptiScaler"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
