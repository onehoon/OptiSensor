<UserControl x:Class="OptiSensor.UI.Views.Pages.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tweaks"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,0,0,16"/>

        <ItemsControl x:Name="TweakCardsList" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.Items>
                <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Intel VRR Range Fix"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>

                            <ToggleButton x:Name="IntelVrrToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Click="IntelVrrToggle_Click"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="IntelVrrPanelNameText"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Text=""/>

                        <TextBlock x:Name="IntelVrrRangeText"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Text=""/>

                        <TextBlock x:Name="IntelVrrResultText"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#334155"
                                   Text="No result yet"/>
                    </StackPanel>
                </Border>
            </ItemsControl.Items>
        </ItemsControl>
    </Grid>
</UserControl>
