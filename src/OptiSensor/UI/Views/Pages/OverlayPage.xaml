<UserControl x:Class="OptiSensor.UI.Views.Pages.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Overlay"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>
            <TextBlock Text="Compose overlay groups. Sensors inside a group are joined with spaces; groups are separated by |."
                       Margin="0,6,0,0"
                       Foreground="#64748B"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource FluentCardStyle}"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Overlay Preview"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#64748B"/>
                <TextBlock x:Name="PreviewTextBlock"
                           Margin="0,8,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource FluentCardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Groups"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                        <TextBlock Text="Group order controls the | separated blocks."
                               Margin="0,4,0,0"
                               Foreground="#64748B"
                               TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="16,0,0,0">
                        <Button Content="Add"
                            MinWidth="64"
                            Margin="0,0,8,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddGroupButton_Click"/>
                        <Button Content="Remove"
                            MinWidth="82"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="RemoveGroupButton_Click"/>
                    </StackPanel>
                    </Grid>

                    <ListBox x:Name="GroupsListBox"
                             ItemsSource="{Binding VisibleOverlayGroups}"
                             SelectedItem="{Binding SelectedOverlayGroup, Mode=TwoWay}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,10,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="10"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="GroupCard"
                                        Padding="10,8"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>
                                        <TextBox MinWidth="32"
                                                 Padding="5,0"
                                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="GroupNameTextBox_TextChanged"
                                                 Style="{StaticResource FluentTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="GroupCard" Property="Background" Value="#EAF3FF"/>
                                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="#2563EB"/>
                                        <Setter TargetName="GroupCard" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0">
                            <TextBlock Text="Group Sensors"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="16,0,0,0">
                            <Button Content="Save" MinWidth="74" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
                            <Button Content="Up" MinWidth="64" Margin="0,0,8,0" Style="{StaticResource NeutralButtonStyle}" Click="MoveUpButton_Click"/>
                            <Button Content="Down" MinWidth="74" Margin="0,0,8,0" Style="{StaticResource NeutralButtonStyle}" Click="MoveDownButton_Click"/>
                            <Button Content="Remove" MinWidth="92" Style="{StaticResource DangerButtonStyle}" Click="RemoveButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="SelectedSensorsDataGrid"
                              ItemsSource="{Binding VisibleSelectedSensors}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              RowHeight="36"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Group" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.GroupSelectionGroups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding GroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource FluentComboBoxStyle}"
                                                  MinWidth="160"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="82">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource FluentDataGridCheckBoxStyle}"/>
                                </DataGridCheckBoxColumn.ElementStyle>
                                <DataGridCheckBoxColumn.EditingElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource FluentDataGridCheckBoxStyle}"/>
                                </DataGridCheckBoxColumn.EditingElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="92"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValueText}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Format" Binding="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="64"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
