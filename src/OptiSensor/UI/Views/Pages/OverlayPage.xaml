<UserControl x:Class="OptiSensor.UI.Views.Pages.OverlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Overlay"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Choose the sensors that appear in the OptiScaler external overlay."
                           Margin="0,6,0,0"
                           Foreground="#64748B"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Up" MinWidth="74" Margin="0,0,8,0" Style="{StaticResource NeutralButtonStyle}" Click="MoveUpButton_Click"/>
                <Button Content="Down" MinWidth="74" Margin="0,0,8,0" Style="{StaticResource NeutralButtonStyle}" Click="MoveDownButton_Click"/>
                <Button Content="Remove" MinWidth="88" Style="{StaticResource DangerButtonStyle}" Click="RemoveButton_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}">
            <DataGrid x:Name="SelectedSensorsDataGrid"
                      ItemsSource="{Binding SelectedSensors}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      RowHeight="34">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                    <DataGridTextColumn Header="Order" Binding="{Binding Order}" IsReadOnly="True" Width="70"/>
                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                    <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Available" Binding="{Binding AvailabilityText}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValueText}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="Format" Binding="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource FluentCardStyle}"
                Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Overlay Preview"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#64748B"/>
                <TextBlock x:Name="PreviewTextBlock"
                           Margin="0,8,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
