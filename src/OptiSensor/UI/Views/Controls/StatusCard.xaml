<UserControl x:Class="OptiSensor.UI.Views.Controls.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="112">
    <Border Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18"
            Margin="0,0,12,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       FontSize="13"
                       Foreground="#64748B"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="ValueTextBlock"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailTextBlock"
                       Grid.Row="2"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="#64748B"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</UserControl>
