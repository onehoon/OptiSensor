<Window x:Class="OptiSensor.UI.OptiScalerReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiScaler Replace"
        Width="520"
        Height="392"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FB">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="OptiScaler Replace"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"/>

        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Game Folder" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FolderText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="#334155"
                               Text="No folder selected"/>
                    <Button x:Name="SelectFolderButton"
                            Grid.Column="1"
                            Content="Select Folder"
                            MinWidth="120"
                            Margin="12,0,0,0"
                            Style="{StaticResource NeutralButtonStyle}"
                            Click="SelectFolderButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Detected" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                <TextBlock x:Name="DetectedText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="#334155"
                           Text="Select a game folder to detect the installed OptiScaler DLL."/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   VerticalAlignment="Top"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#64748B"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource NeutralButtonStyle}"
                    Click="CancelButton_Click"/>
            <Button x:Name="ReplaceButton"
                    Content="Replace"
                    MinWidth="110"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ReplaceButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
