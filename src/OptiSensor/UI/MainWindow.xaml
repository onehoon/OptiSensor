<Window x:Class="OptiSensor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiSensor"
        Width="720"
        Height="690"
        MinWidth="640"
        MinHeight="600"
        Background="#F6F8FB"
        Icon="/Assets/OptiSensor.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="OptiSensor"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Current Overlay Feed"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>
                <TextBlock x:Name="OverlayFeedText"
                           Margin="0,10,0,0"
                           FontSize="13"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           TextWrapping="Wrap"
                           Foreground="#334155"
                           Text="Waiting for telemetry..."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="OptiScaler Replace"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#64748B"
                               Text="Replace an existing OptiScaler 0.9 DLL with the latest OptiSensor-compatible build."/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Manage"
                        MinWidth="96"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource NeutralButtonStyle}"
                        Click="ManageOptiScalerButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Intel VRR Range Fix"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               VerticalAlignment="Center"/>
                    <ToggleButton x:Name="IntelVrrToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Click="IntelVrrToggle_Click"
                                  VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="IntelVrrPanelNameText" Margin="0,8,0,0" FontSize="12" Foreground="#64748B"/>
                <TextBlock x:Name="IntelVrrRangeText" Margin="0,2,0,0" FontSize="12" Foreground="#64748B"/>
                <TextBlock x:Name="IntelVrrResultText" Margin="0,8,0,0" FontSize="12" Foreground="#334155" Text="No result yet"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock x:Name="StartWithWindowsStatusText"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="#64748B"/>
                </StackPanel>
                <ToggleButton x:Name="StartWithWindowsToggle"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Click="StartWithWindowsToggle_Click"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open Settings Folder"
                    MinWidth="150"
                    Margin="0,0,8,0"
                    Style="{StaticResource NeutralButtonStyle}"
                    Click="OpenSettingsFolderButton_Click"/>
            <Button Content="Hide to Tray"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource NeutralButtonStyle}"
                    Click="HideButton_Click"/>
            <Button Content="Exit"
                    MinWidth="88"
                    Style="{StaticResource DangerButtonStyle}"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
