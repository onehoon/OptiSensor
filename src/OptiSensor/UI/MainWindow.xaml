<Window x:Class="OptiSensor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiSensor"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="#F6F8FB"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="OptiSensor"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Hardware overlay helper"
                               Margin="0,4,0,24"
                               Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button x:Name="DashboardNavButton"
                            Content="Dashboard"
                            Style="{StaticResource NavButtonStyle}"
                            Click="DashboardNavButton_Click"/>
                    <Button x:Name="SensorsNavButton"
                            Content="Sensors"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SensorsNavButton_Click"/>
                    <Button x:Name="OverlayNavButton"
                            Content="Overlay"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OverlayNavButton_Click"/>
                    <Button x:Name="SettingsNavButton"
                            Content="Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsNavButton_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Local overlay feed"
                           Foreground="#94A3B8"
                           FontSize="12"/>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContentControl"
                        Grid.Column="1"
                        Margin="28"/>
    </Grid>
</Window>
