<Window x:Class="OptiSensor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiSensor"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="OptiSensor"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Status" Margin="0,0,8,0">
                <TextBlock x:Name="StatusTextBlock" Margin="8" Text="Starting..."/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Last Overlay" Margin="0,0,8,0">
                <TextBlock x:Name="LastOverlayTextBlock"
                           Margin="8"
                           Text="No GPU sensor values available."
                           TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Runtime">
                <StackPanel Margin="8">
                    <TextBlock x:Name="StartupTextBlock"/>
                    <TextBlock x:Name="PublishIntervalTextBlock" Margin="0,4,0,0"/>
                    <TextBlock x:Name="DetectedSensorCountTextBlock" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SelectedSensorCountTextBlock" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SettingsStateTextBlock" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Detected Sensors" Margin="0,0,0,10">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button x:Name="RefreshSensorsButton" Content="Refresh" MinWidth="80" Margin="0,0,8,0" Click="RefreshDetectedSensors_Click"/>
                    <Button Content="Add" MinWidth="80" Click="AddSelectedSensor_Click"/>
                </StackPanel>

                <DataGrid x:Name="DetectedSensorsDataGrid"
                          ItemsSource="{Binding DetectedSensors}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                        <DataGridTextColumn Header="Hardware" Binding="{Binding HardwareName}" Width="2*"/>
                        <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" Width="110"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Selected Overlay Sensors" Margin="0,0,0,10">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="Up" MinWidth="70" Margin="0,0,8,0" Click="MoveSelectedSensorUp_Click"/>
                    <Button Content="Down" MinWidth="70" Margin="0,0,8,0" Click="MoveSelectedSensorDown_Click"/>
                    <Button Content="Remove" MinWidth="80" Click="RemoveSelectedSensor_Click"/>
                </StackPanel>

                <DataGrid x:Name="SelectedSensorsDataGrid"
                          ItemsSource="{Binding SelectedSensors}"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Order" Binding="{Binding Order}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding SensorType}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Available" Binding="{Binding AvailabilityText}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValueText}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" MinWidth="80" Margin="0,0,8,0" Click="SaveSettings_Click"/>
            <Button Content="Hide to Tray" MinWidth="90" Margin="0,0,8,0" Click="HideToTray_Click"/>
            <Button Content="Open Settings Folder" MinWidth="130" Margin="0,0,8,0" Click="OpenSettingsFolder_Click"/>
            <Button Content="Exit" MinWidth="80" Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
