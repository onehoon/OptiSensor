<Window x:Class="OptiSensor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiSensor v0.1.0"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Background="#F6F8FB"
        Icon="/Assets/OptiSensor.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="OptiSensor"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Hardware overlay helper"
                               Margin="0,4,0,24"
                               Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button x:Name="OverlayNavButton"
                            Content="Overlay"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OverlayNavButton_Click"/>
                    <Button x:Name="SensorsNavButton"
                            Content="Sensors"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SensorsNavButton_Click"/>
                    <Button x:Name="SettingsNavButton"
                            Content="Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsNavButton_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Local overlay feed"
                           Foreground="#94A3B8"
                           FontSize="12"/>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContentControl"
                        Grid.Column="1"
                        Margin="28"/>
    </Grid>
</Window>
