From 6f94aa9756f6a250c624fc84caf10da51729ad41 Mon Sep 17 00:00:00 2001
From: OptiSensor Patch Bot <optisensor@example.invalid>
Date: Wed, 1 Jul 2026 11:39:43 +0900
Subject: [PATCH 1/5] Add FPS Only overlay type

---
 OptiScaler.ini                  | 4 ++--
 OptiScaler/Config.h             | 3 ++-
 OptiScaler/menu/menu_common.cpp | 2 +-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/OptiScaler.ini b/OptiScaler.ini
index 1ed093be..7ade12ac 100644
--- a/OptiScaler.ini
+++ b/OptiScaler.ini
@@ -821,8 +821,8 @@ FpsScale=auto
 FpsOverlayPos=auto
 
 ; FPS overlay type
-; 0 = Just FPS | 1 = Simple | 2 = Detailed | 3 = Detailed + Graph | 4 Full | 5 Full + Graph | 6 Reflex timings
-; 0 to 6 - Default (auto) is 0
+; 0 = Just FPS | 1 = Simple | 2 = Detailed | 3 = Detailed + Graph | 4 = Full | 5 = Full + Graph | 6 = Reflex timings | 7 = FPS Only
+; 0 to 7 - Default (auto) is 0
 FpsOverlayType=auto
 
 ; Shortcut key for FPS overlay
diff --git a/OptiScaler/Config.h b/OptiScaler/Config.h
index 766e3ea6..9b32f25c 100644
--- a/OptiScaler/Config.h
+++ b/OptiScaler/Config.h
@@ -156,6 +156,7 @@ enum FpsOverlay : uint32_t
     FpsOverlay_Full,
     FpsOverlay_FullGraph,
     FpsOverlay_ReflexTimings,
+    FpsOverlay_FpsOnly,
     FpsOverlay_COUNT,
 };
 
@@ -326,7 +327,7 @@ class Config
     CustomOptional<int> FpsOverlayPos { 0 };
     /// 0 Only FPS, 1 +Avg FPS & Upscaler info 2 +Frame Time,
     /// 3 +Upscaler Time, 4 +Frame Time Graph, 5 +Upscaler Time Graph
-    /// 6 +Reflex timings
+    /// 6 +Reflex timings, 7 FPS only
     CustomOptional<FpsOverlay> FpsOverlayType { FpsOverlay_JustFPS };
     CustomOptional<int> FpsShortcutKey { VK_PRIOR };
     CustomOptional<int> FpsCycleShortcutKey { VK_NEXT };
diff --git a/OptiScaler/menu/menu_common.cpp b/OptiScaler/menu/menu_common.cpp
index 53f8fb08..0100e5da 100644
--- a/OptiScaler/menu/menu_common.cpp
+++ b/OptiScaler/menu/menu_common.cpp
@@ -6269,7 +6269,7 @@ void MenuCommon::RenderFpsOverlaySettings(RenderMenuContext& ctx)
         }
 
         const char* fpsType[] = { "Just FPS", "Simple",       "Detailed",      "Detailed + Graph",
-                                  "Full",     "Full + Graph", "Reflex timings" };
+                                  "Full",     "Full + Graph", "Reflex timings", "FPS Only" };
         const char* selectedType = fpsType[config->FpsOverlayType.value_or_default()];
 
         if (ImGui::BeginCombo("Overlay Type", selectedType))
-- 
