From 64649364900056bd9e1e8ce5c1fc7231ee7a8874 Mon Sep 17 00:00:00 2001
From: OptiSensor Patch Bot <optisensor@example.invalid>
Date: Wed, 1 Jul 2026 11:40:27 +0900
Subject: [PATCH 2/5] Add external overlay append config

---
 OptiScaler.ini                  |  8 ++++++++
 OptiScaler/Config.cpp           | 11 +++++++++++
 OptiScaler/Config.h             |  1 +
 OptiScaler/menu/menu_common.cpp |  4 ++++
 4 files changed, 24 insertions(+)

diff --git a/OptiScaler.ini b/OptiScaler.ini
index 7ade12ac..97093a52 100644
--- a/OptiScaler.ini
+++ b/OptiScaler.ini
@@ -1525,3 +1525,11 @@ OutputResourceBarrier=auto
 ; 
 ; All state values can be checked from here
 ; https://learn.microsoft.com/en-us/windows/win32/api/d3d12/ne-d3d12-d3d12_resource_states
+
+
+; -------------------------------------------------------
+[ExternalOverlay]
+; -------------------------------------------------------
+; Append text published by OptiSensor to the FPS Only overlay
+; true or false - Default (auto) is false
+AppendExternalOverlayText=true
diff --git a/OptiScaler/Config.cpp b/OptiScaler/Config.cpp
index 896b9423..b10fba23 100644
--- a/OptiScaler/Config.cpp
+++ b/OptiScaler/Config.cpp
@@ -460,6 +460,11 @@ bool Config::Reload(std::filesystem::path iniPath)
             if (auto setting = readFloat("Menu", "FpsScale"); setting.has_value())
                 FpsScale.set_from_config(std::clamp(setting.value(), 0.5f, 2.0f));
 
+            auto appendExternalOverlayText = readBool("ExternalOverlay", "AppendExternalOverlayText");
+            if (!appendExternalOverlayText.has_value())
+                appendExternalOverlayText = readBool("ExternalOverlay", "Enabled");
+            AppendExternalOverlayText.set_from_config(appendExternalOverlayText);
+
             FontSize.set_from_config(readFloat("Menu", "FontSize"));
             TTFFontPath.set_from_config(readWString("Menu", "TTFFontPath"));
 
@@ -1251,6 +1256,12 @@ bool Config::SaveIni()
         ini.SetValue("Menu", "BGColorA", GetFloatValue(Instance()->MenuBGColorA.value_for_config()).c_str());
     }
 
+    // ExternalOverlay
+    {
+        ini.SetValue("ExternalOverlay", "AppendExternalOverlayText",
+                     GetBoolValue(Instance()->AppendExternalOverlayText.value_for_config()).c_str());
+    }
+
     // Hooks
     {
         ini.SetValue("Hooks", "HookOriginalNvngxOnly",
diff --git a/OptiScaler/Config.h b/OptiScaler/Config.h
index 9b32f25c..abb5192a 100644
--- a/OptiScaler/Config.h
+++ b/OptiScaler/Config.h
@@ -334,6 +334,7 @@ class Config
     CustomOptional<bool> FpsOverlayHorizontal { false };
     CustomOptional<float> FpsOverlayAlpha { 0.4f };
     CustomOptional<float, NoDefault> FpsScale; // No value means same as MenuScale
+    CustomOptional<bool> AppendExternalOverlayText { false };
     CustomOptional<bool> UseHQFont { true };
     CustomOptional<bool> DisableSplash { false };
     CustomOptional<float> FontSize { 14.0f };
diff --git a/OptiScaler/menu/menu_common.cpp b/OptiScaler/menu/menu_common.cpp
index 0100e5da..92ca6c95 100644
--- a/OptiScaler/menu/menu_common.cpp
+++ b/OptiScaler/menu/menu_common.cpp
@@ -6283,6 +6283,10 @@ void MenuCommon::RenderFpsOverlaySettings(RenderMenuContext& ctx)
             ImGui::EndCombo();
         }
 
+        bool externalOverlayEnabled = config->AppendExternalOverlayText.value_or_default();
+        if (ImGui::Checkbox("Append OptiSensor text", &externalOverlayEnabled))
+            config->AppendExternalOverlayText = externalOverlayEnabled;
+
         float fpsAlpha = config->FpsOverlayAlpha.value_or_default();
         if (ImGui::SliderFloat("Background Alpha", &fpsAlpha, 0.0f, 1.0f, "%.2f"))
             config->FpsOverlayAlpha = fpsAlpha;
-- 
2.53.0.windows.2

