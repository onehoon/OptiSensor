diff --git a/OptiScaler/misc/ExternalOverlayFeed.cpp b/OptiScaler/misc/ExternalOverlayFeed.cpp
new file mode 100644
index 00000000..c4cf3851
--- /dev/null
+++ b/OptiScaler/misc/ExternalOverlayFeed.cpp
@@ -0,0 +1,135 @@
+#include "pch.h"
+#include "ExternalOverlayFeed.h"
+
+#include <array>
+#include <cstddef>
+#include <cstring>
+
+namespace
+{
+constexpr wchar_t MappingName[] = L"Local\\OptiScalerExternalOverlay";
+constexpr uint32_t PayloadMagic = 0x564F534F; // OSOV
+constexpr uint32_t PayloadVersion = 1;
+constexpr uint32_t MaxLines = 4;
+constexpr uint32_t MaxLineLength = 128;
+constexpr uint64_t StaleAfterMs = 2000;
+constexpr uint64_t OpenRetryMs = 1000;
+
+struct ExternalOverlayPayload
+{
+    uint32_t magic;
+    uint32_t version;
+    volatile uint32_t sequence;
+    uint64_t lastUpdateTickMs;
+    uint32_t lineCount;
+    // Lines are UTF-8, null-terminated byte strings written by OptiSensor.
+    char lines[MaxLines][MaxLineLength];
+};
+
+static_assert(offsetof(ExternalOverlayPayload, lastUpdateTickMs) == 16);
+static_assert(offsetof(ExternalOverlayPayload, lineCount) == 24);
+static_assert(offsetof(ExternalOverlayPayload, lines) == 28);
+static_assert(sizeof(ExternalOverlayPayload) == 544);
+
+HANDLE g_mapping = nullptr;
+ExternalOverlayPayload* g_payload = nullptr;
+uint64_t g_nextOpenAttemptTick = 0;
+
+void CloseMapping()
+{
+    if (g_payload != nullptr)
+    {
+        UnmapViewOfFile(g_payload);
+        g_payload = nullptr;
+    }
+
+    if (g_mapping != nullptr)
+    {
+        CloseHandle(g_mapping);
+        g_mapping = nullptr;
+    }
+}
+
+bool EnsureMapped(uint64_t now)
+{
+    if (g_payload != nullptr)
+        return true;
+
+    if (now < g_nextOpenAttemptTick)
+        return false;
+
+    g_nextOpenAttemptTick = now + OpenRetryMs;
+
+    g_mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, MappingName);
+    if (g_mapping == nullptr)
+        return false;
+
+    g_payload = static_cast<ExternalOverlayPayload*>(MapViewOfFile(g_mapping, FILE_MAP_READ, 0, 0,
+                                                                   sizeof(ExternalOverlayPayload)));
+    if (g_payload == nullptr)
+    {
+        CloseMapping();
+        return false;
+    }
+
+    return true;
+}
+
+bool TryReadLineImpl(std::string& line)
+{
+    const auto now = GetTickCount64();
+    if (!EnsureMapped(now))
+        return false;
+
+    if (g_payload->magic != PayloadMagic || g_payload->version != PayloadVersion)
+    {
+        CloseMapping();
+        return false;
+    }
+
+    const auto sequenceBefore = g_payload->sequence;
+    if ((sequenceBefore & 1U) != 0)
+        return false;
+
+    MemoryBarrier();
+
+    const auto lastUpdateTickMs = g_payload->lastUpdateTickMs;
+    const auto lineCount = g_payload->lineCount;
+
+    if (lineCount == 0 || lineCount > MaxLines)
+        return false;
+
+    if (lastUpdateTickMs == 0 || lastUpdateTickMs > now || now - lastUpdateTickMs > StaleAfterMs)
+        return false;
+
+    std::array<char, MaxLineLength> buffer {};
+    memcpy(buffer.data(), g_payload->lines[0], buffer.size());
+
+    MemoryBarrier();
+
+    const auto sequenceAfter = g_payload->sequence;
+    if (sequenceBefore != sequenceAfter || (sequenceAfter & 1U) != 0)
+        return false;
+
+    const auto length = strnlen_s(buffer.data(), buffer.size());
+    if (length == 0)
+        return false;
+
+    line.assign(buffer.data(), length);
+    return true;
+}
+}
+
+bool ExternalOverlayFeed::TryReadLine(std::string& line)
+{
+    try
+    {
+        line.clear();
+        return TryReadLineImpl(line);
+    }
+    catch (...)
+    {
+        line.clear();
+        return false;
+    }
+}
