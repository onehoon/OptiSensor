From a8d71981bc8bfa0e01932de1162156b0d8e2cc3c Mon Sep 17 00:00:00 2001
From: OptiSensor Patch Bot <optisensor@example.invalid>
Date: Fri, 17 Jul 2026 17:24:13 +0900
Subject: [PATCH 3/3] Append external text only for external FPS overlay

---
 OptiScaler/menu/menu_common.cpp | 28 ++++++++++++++++++++--------
 1 file changed, 20 insertions(+), 8 deletions(-)

diff --git a/OptiScaler/menu/menu_common.cpp b/OptiScaler/menu/menu_common.cpp
index f8eb548..dfe54d8 100644
--- a/OptiScaler/menu/menu_common.cpp
+++ b/OptiScaler/menu/menu_common.cpp
@@ -34,6 +34,7 @@
 #include <memory>
 #include <type_traits>
 #include <misc/IdentifyGpu.h>
+#include <misc/ExternalOverlayFeed.h>
 #include <hooks/Xell_Hooks.h>
 #include <low_latency/input/input_common.h>
 
@@ -1785,6 +1786,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
             }
 
             const auto overlayType = config->FpsOverlayType.value_or_default();
+            const bool isJustFpsOverlay = overlayType == FpsOverlay_JustFPS || overlayType == FpsOverlay_JustFPSExternal;
             const bool hasFeature = currentFeature && !currentFeature->IsFrozen();
 
             // Prepare Line 1
@@ -1808,6 +1810,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                 switch (overlayType)
                 {
                 case FpsOverlay_JustFPS:
+                case FpsOverlay_JustFPSExternal:
                     fpsPart = StrFmt("FPS: %6.1f/%5.1f", frameRate, baseFps);
                     break;
 
@@ -1825,6 +1828,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                 switch (overlayType)
                 {
                 case FpsOverlay_JustFPS:
+                case FpsOverlay_JustFPSExternal:
                     fpsPart = StrFmt("FPS: %6.1f", frameRate);
                     break;
 
@@ -1838,13 +1842,21 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                 }
             }
 
-            if (overlayType == FpsOverlay_JustFPS)
+            if (isJustFpsOverlay)
+            {
                 firstLine = StrFmt("%s", fpsPart.c_str());
+                if (overlayType == FpsOverlay_JustFPSExternal)
+                {
+                    std::string externalLine;
+                    if (ExternalOverlayFeed::TryReadLine(externalLine))
+                        firstLine += " | " + externalLine;
+                }
+            }
             else
                 firstLine = StrFmt("%s | %s%s%s", api.c_str(), fpsPart.c_str(), fgText.c_str(), featurePart.c_str());
 
             // Prepare Line 2
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_Detailed)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_Detailed)
             {
                 if (config->FpsOverlayHorizontal.value_or_default())
                 {
@@ -1861,7 +1873,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
             }
 
             // Prepare Line 3
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_Full)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_Full)
             {
                 thirdLine =
                     StrFmt("Upscaler Time: %7.2f ms, Avg: %7.2f ms", state.upscaleTimes.back(), averageUpscalerFT);
@@ -1894,7 +1906,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
             // Draw the overlay
             ImGui::Text(firstLine.c_str());
 
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_Detailed)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_Detailed)
             {
                 if (config->FpsOverlayHorizontal.value_or_default())
                 {
@@ -1910,7 +1922,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                 ImGui::Text(secondLine.c_str());
             }
 
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_DetailedGraph)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_DetailedGraph)
             {
                 if (config->FpsOverlayHorizontal.value_or_default())
                     ImGui::SameLine(0.0f, 0.0f);
@@ -1922,7 +1934,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                     &gFrameTimes, plotWidth, 0, nullptr, 0.0f, 66.6f, plotSize);
             }
 
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_Full)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_Full)
             {
                 if (config->FpsOverlayHorizontal.value_or_default())
                 {
@@ -1938,7 +1950,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                 ImGui::Text(thirdLine.c_str());
             }
 
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_FullGraph)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_FullGraph)
             {
                 if (config->FpsOverlayHorizontal.value_or_default())
                     ImGui::SameLine(0.0f, 0.0f);
@@ -1950,7 +1962,7 @@ void MenuCommon::RenderPerformanceOverlay(RenderMenuContext& ctx)
                     &gUpscalerTimes, plotWidth, 0, nullptr, 0.0f, 20.0f, plotSize);
             }
 
-            if (config->FpsOverlayType.value_or_default() >= FpsOverlay_ReflexTimings)
+            if (!isJustFpsOverlay && overlayType >= FpsOverlay_ReflexTimings)
             {
                 constexpr auto delayBetweenPollsMs = 500;
                 static auto previousPoll = 0.0;
-- 
